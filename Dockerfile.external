# AI个性化饮食管理 Agent —— 外部常驻主机镜像（路线 B）
# 仅打包精简外部入口（external_main.py），不含平台版 main.py 的 Coze 专属运行时依赖链。
# 通过 src_external/ 兼容 shim 提供 coze_coding_utils 的最小等价实现。
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    COZE_WORKSPACE_PATH=/app \
    PYTHONPATH=/app/src:/app/src_external \
    EXTERNAL_MODE=1

WORKDIR /app

# 系统依赖（最小化，curl 用于健康检查）
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# Python 依赖 —— 完整覆盖 external_main 全链路所需（agent + tools + storage）
# 不安装 Coze 专属库（coze-coding-utils / coze-coding-dev-sdk / cozeloop），由 src_external shim 承担。
RUN pip install --upgrade pip && pip install \
    "uvicorn[standard]" \
    "fastapi" \
    "pydantic>=2.12,<3" \
    "httpx" \
    "python-dotenv" \
    "langchain>=1.0.3,<2" \
    "langchain-core>=1.0,<2" \
    "langchain-openai>=1.0.1,<2" \
    "langgraph>=1.0.2,<2" \
    "langgraph-checkpoint>=3.0,<4" \
    "langgraph-checkpoint-postgres>=3.0,<4" \
    "langgraph-sdk>=0.2,<1" \
    "langsmith>=0.4,<1" \
    "openai" \
    "supabase" \
    "psycopg[binary]>=3.3,<4" \
    "psycopg-pool>=3.3,<4" \
    "SQLAlchemy>=2.0,<3" \
    "boto3>=1.40,<2" \
    "alembic>=1.16,<2"

# 应用源码与资源（COZE_WORKSPACE_PATH=/app，代码用相对 /app 定位 config/assets）
COPY src/ ./src/
COPY src_external/ ./src_external/
COPY assets/ ./assets/
COPY config/ ./config/

# 健康检查（Render 会周期性调用；监听全端口）
EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsS http://localhost:${PORT:-7860}/health || exit 1

# 外部入口：监听 ${PORT:-7860}（Render 自动注入 PORT；本地默认 7860）
CMD ["sh", "-c", "exec uvicorn external_main:app --host 0.0.0.0 --port ${PORT:-7860}"]