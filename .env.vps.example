# ============================================================
# AI个性化饮食管理 Agent — 国内 VPS 部署环境变量模板
# 用法: cp docs/DEPLOY_VPS.md 中字段, 或设置环境变量后运行 deploy_vps.sh
# 注意: 以下含真实值示例，请替换为你自己的；不要把本文件提交到公开仓库。
# ============================================================

# ---- 外部 LLM（强烈建议用海外可直连的合规端点，或保持国内端点+国内主机，二者同区域才快）----
EXTERNAL_OPENAI_BASE_URL=https://llmapi.paratera.com/v1
EXTERNAL_OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY
EXTERNAL_OPENAI_MODEL=DeepSeek-V4-Pro-0813

# ---- Supabase（复用现有外部可访问库；也可以新开一个库后按 docs/EXTERNAL_SCHEMA.sql 建表）----
COZE_SUPABASE_URL=REPLACE_WITH_SUPABASE_URL
COZE_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
COZE_SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# ---- 其他 ----
EXTERNAL_KNOWLEDGE_DISABLED=1
# 允许多个来源时用逗号分隔，如 https://a.com,https://b.com；* 表示全部（测试期）
EXTERNAL_CORS_ORIGINS=*

# ---- 部署端口 ----
APP_PORT=7860
# 可执行: set -a; source .env.vps.prod; bash scripts/deploy_vps.sh