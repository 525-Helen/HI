# ===== AI个性化饮食管理 Agent —— 外部常驻主机部署环境变量模板 =====
# 复制为 .env（本地）或在 Render / 云主机控制台的环境变量面板中逐项填写。

# ── 必填：外部 OpenAI 兼容 LLM（路线 B 的核心替换点）──────────────────
# Base URL，一般以 /v1 结尾（OpenAI 兼容 chat/completions 路径）
EXTERNAL_OPENAI_BASE_URL=https://llmapi.paratera.com/v1
# 你的外部 LLM API Key（只存在服务端，不要写进前端/仓库）
EXTERNAL_OPENAI_API_KEY=<你的外部 LLM API Key>
# 模型名（DeepSeek-V4-Pro-0813 / deepseek-chat / glm-4-flash 等）
EXTERNAL_OPENAI_MODEL=DeepSeek-V4-Pro-0813

# ── 必填：Supabase（Postgres）持久化凭据 ──────────────────────────────
# 数据表结构见 docs/EXTERNAL_SCHEMA.sql（需要时用 SQL Editor 执行一次）
COZE_SUPABASE_URL=<你的 Supabase 项目 URL>
COZE_SUPABASE_ANON_KEY=<你的 anon key>
# 服务角色 key（写入/删除记录用；若 anon 权限足够可留空，读取用户档案/饮食记录依赖它）
COZE_SUPABASE_SERVICE_ROLE_KEY=<你的 service_role key>

# ── 可选：外部知识库降级 ──────────────────────────────────────────────
# =1 时关闭 Coze 托管向量知识库，营养知识问答退回「通用常识」回答（外部主机必设）
EXTERNAL_KNOWLEDGE_DISABLED=1

# ── 可选：HTTP 服务 ──────────────────────────────────────────────────
# 监听端口（Render 会自动注入 PORT；本地默认 7860）
PORT=7860
# 允许跨域的前端来源，逗号分隔；默认 * 允许所有（自定义前端用）
EXTERNAL_CORS_ORIGINS=*
# 本项目（用于日志/展示）
EXTERNAL_PROJECT_ID=ai-diet-agent-external